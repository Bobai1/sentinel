# Optional. Leave empty for a public demo console.
SENTINEL_API_TOKEN=

# Ethereum JSON-RPC. Use a paid archive-capable provider for production.
SENTINEL_RPC_URL=https://ethereum-rpc.publicnode.com
SENTINEL_POLL_MS=12000
SENTINEL_MIN_ETH=10
SENTINEL_TRACE=1
SENTINEL_WATCHED_ADDRESSES=
SENTINEL_KYC_ENDPOINTS=

# Tron. Uses TronGrid.
SENTINEL_TRON=1
SENTINEL_TRON_POLL_MS=15000
SENTINEL_TRON_RPC_URL=https://api.trongrid.io
SENTINEL_TRON_WATCHED_ADDRESSES=
SENTINEL_TRON_KYC_ENDPOINTS=

# Set to 0 to stop the detector loop without redeploying.
SENTINEL_DETECTOR=1
